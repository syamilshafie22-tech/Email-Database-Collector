def start_process():

    imap_server = imap_entry.get().strip()
    email_user = email_entry.get().strip()
    email_pass = password_entry.get().strip()

    excel_name = filename_entry.get().strip()

    if not imap_server or not email_user or not email_pass:
        messagebox.showwarning(
            "Missing Information",
            "Please fill in IMAP Server, Email and Email Passkey."
        )
        return

    if not excel_name:
        messagebox.showwarning(
            "Missing Information",
            "Please enter an Excel file name."
        )
        return

    # Automatically add .xlsx if not provided
    if not excel_name.lower().endswith(".xlsx"):
        excel_name += ".xlsx"

    # Prevent saving outside the script directory
    if os.path.basename(excel_name) != excel_name:
        messagebox.showwarning(
            "Invalid File Name",
            "Please enter only the Excel file name, without a folder path."
        )
        return

    excel_file = os.path.join(SCRIPT_DIR, excel_name)

    start_button.config(state="disabled")
    status_label.config(text="Connecting to email...")

    def process():

        try:

            data = fetch_order_emails(
                imap_server,
                email_user,
                email_pass
            )

            total = save_to_excel(data, excel_file)

            def success():

                status_label.config(
                    text="Process completed successfully!"
                )

                messagebox.showinfo(
                    "Success",
                    f"Email extraction completed!\n\n"
                    f"Emails processed: {len(data)}\n"
                    f"Total Excel records: {total}\n\n"
                    f"Saved to:\n{excel_file}"
                )

            root.after(0, success)

        except Exception as e:

            def show_error():

                status_label.config(text="Process failed.")

                messagebox.showerror(
                    "Error",
                    str(e)
                )

            root.after(0, show_error)

        finally:

            root.after(
                0,
                lambda: start_button.config(state="normal")
            )

    threading.Thread(
        target=process,
        daemon=True
    ).start()


